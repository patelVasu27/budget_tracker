# Supabase configuration — DEVELOPMENT project (separate from production)
# Get these from: Supabase Dashboard → Project Settings → API
# This file is for local development only. Never commit real credentials.
VITE_SUPABASE_URL=your-dev-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-dev-supabase-anon-key

# NOTE: VITE_ prefix is required for Vite to expose env vars to client code.
# Copy this file to .env.local and fill in your dev project credentials.

# API Layer feature flag — set to true to route data through Vercel API endpoints
# instead of direct Supabase access. Default: false (direct Supabase).
VITE_USE_API_LAYER=true